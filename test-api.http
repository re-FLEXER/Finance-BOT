### 3. Імітація вебхуку Monobank на твій сервер
POST http://localhost:3000/monobank
Content-Type: application/json

{
  "type": "statement_item",
  "data": {
    "account": "test_account",
    "statementItem": {
      "id": "test_mono_id_12345",
      "time": 1724697600,
      "description": "Тестування вебхуку Monobank",
      "mcc": 5411,
      "originalAmount": -15000,
      "amount": -15000,
      "operationAmount": -15000,
      "currencyCode": 980,
      "commissionRate": 0,
      "cashbackAmount": 0,
      "balance": 500000,
      "hold": false
    }
  }
}