generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String   // "income", "expense" або "saving"
  amount      Float    
  category    String   
  description String?  
  workspace   String   @default("Особисте") // "Особисте" або "Проєкт"
  createdAt   DateTime @default(now())
}