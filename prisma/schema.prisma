generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String   // "income", "expense" або "saving"
  amount      Float    
  category    String   
  description String?  
  workspace   String   @default("Особисте") // "Особисте" або "Проєкт"
  createdAt   DateTime @default(now())
  monoId      String?  @unique // унікальний ідентифікатор транзакції з Mono API
  source      String?  @default("card") // 'card' або 'cash' (звідки)
  toSource    String?  // 'card' або 'cash' (куди, використовується тільки для type: 'transfer'
  is_deleted  Boolean  @default(false)
  batchId     String?  // для групування транзакцій
}

model ChatHistory {
  id        Int      @id @default(autoincrement())
  userId    BigInt
  role      String   // 'user' або 'model'
  text      String
  createdAt DateTime @default(now())
}

model ReportQueue{
  id       Int      @id @default(autoincrement())
  prompt   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

